# ===========================================================================
# Byte-compiled / optimized / DLL files
# ===========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# ===========================================================================
# Virtual Environments
# ===========================================================================
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ===========================================================================
# Unit Test, Linter & Coverage Caches
# ===========================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ===========================================================================
# Packaging & Build Distribution
# ===========================================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===========================================================================
# Secrets, Credentials & Local Config
# ===========================================================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
credentials.json
client_secrets.json
id_rsa
id_ed25519

# ===========================================================================
# Operating System Artifacts
# ===========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========================================================================
# Editor & IDE Settings
# ===========================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ===========================================================================
# Captured User Data, Recordings & Camera Dumps
# ===========================================================================
snapshots/*
!snapshots/.gitkeep
color_object_detection/snapshots/*
!color_object_detection/snapshots/.gitkeep
captured_frames/
snapshot_*.png

# Video recordings (ignore camera dumps and temporary test videos)
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Preserve bundled benchmark test assets
!assets/
!assets/.gitkeep
!assets/color_test_benchmark.mp4
!color_object_detection/assets/
!color_object_detection/assets/.gitkeep
!color_object_detection/assets/color_test_benchmark.mp4

# ===========================================================================
# Local Scratch & Temporary Files
# ===========================================================================
scratch/
tmp/
*.tmp
*.log
