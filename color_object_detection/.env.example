# Color-Based Object Detection - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.

# Camera / Capture Settings
DEFAULT_CAMERA_INDEX=0
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
CAPTURE_FPS=30

# Detection & Tracking Parameters
MIN_CONTOUR_AREA=500
FPS_SMOOTHING_WINDOW=30

# Output Storage Directories (relative to repository root or absolute)
SNAPSHOT_DIR=snapshots
BENCHMARK_RESULTS_DIR=benchmark_results
